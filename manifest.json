{
  "manifest_version": 2,
  "name": "X Keyword Blocker",
  "version": "1.2.0",
  "description": "Hides posts and replies on x.com that contain blocked keywords.",
  "homepage_url": "https://github.com/ThisaraJayas/x-keyword-blocker",
  "permissions": ["storage", "*://x.com/*", "*://twitter.com/*"],
  "content_scripts": [
    {
      "matches": ["*://x.com/*", "*://*.x.com/*", "*://twitter.com/*", "*://*.twitter.com/*"],
      "js": ["defaults.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "scripts": ["defaults.js", "background.js"]
  },
  "browser_action": {
    "default_title": "X Keyword Blocker",
    "default_popup": "popup.html"
  },
  "options_ui": {
    "page": "popup.html",
    "open_in_tab": true
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "x-keyword-blocker@thisarajayas.github.io",
      "strict_min_version": "109.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}
